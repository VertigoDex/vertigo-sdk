{
  "name": "@vertigo-amm/vertigo-sdk",
  "version": "3.0.0",
  "description": "Official TypeScript SDK for the Vertigo AMM protocol on Solana",
  "homepage": "https://vertigo.so",
  "repository": {
    "type": "git",
    "url": "https://github.com/vertigo-protocol/vertigo-sdk"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/idl"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/spl-token": "^0.4.12",
    "@solana/web3.js": "^1.95.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
